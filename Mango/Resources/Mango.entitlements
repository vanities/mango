<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud key-value storage for cross-device reading position. Works in the simulator now;
	     enable iCloud on the App ID in the developer portal to add it to device builds too. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- Shares the current book with the Continue Reading widget. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vanities.mango</string>
	</array>
</dict>
</plist>
